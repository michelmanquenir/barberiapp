# ─── COPIA ESTE ARCHIVO COMO .env Y RELLENA LOS VALORES ──────────────────────
# .env está en .gitignore — nunca se sube a Git

# URL del backend (Spring Boot)
# En desarrollo: dejar vacío → el proxy de Vite redirige /api → localhost:8080
# En producción: URL completa de tu backend en Render
VITE_API_URL=

# Supabase (para imágenes / storage)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=tu-api-key-aqui
